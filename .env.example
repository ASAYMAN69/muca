# ---------------------------------------------------------------------------
# Muca — Amazon Developer Hackathon 2026 (Alexa+ track)
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Single port serving BOTH the Next.js frontend (/) and the API + MCP server
# (/api/v1/*). Do not change without also updating the frontend proxy target.
PORT=8099

# Comma-separated list of allowed CORS origins for the API.
ALLOWED_ORIGINS=http://localhost:8099

# --- AI gateway -------------------------------------------------------------
# The server configures up to three HTTP model endpoints and probes them in
# parallel at startup. It uses the highest-priority one that answers:
#
#     anthropic  >  openai  >  gemini
#
# AI_PROVIDER:
#   auto       probe every configured endpoint and pick the best (default)
#   anthropic | openai | gemini
#              use that one; if it fails its probe the agent is disabled
#              rather than silently switching
#   bedrock    AWS Bedrock via the standard AWS credential chain
AI_PROVIDER=auto

# How long one probe may take before it counts as failed.
AI_PROBE_TIMEOUT_MS=4000

# Anthropic (Messages API). ANTHROPIC_MODEL is required; there is no default.
ANTHROPIC_API_KEY=
ANTHROPIC_ENDPOINT=https://api.anthropic.com
ANTHROPIC_MODEL=

# OpenAI, or any OpenAI-compatible endpoint. Leave the key empty to run Muca
# without a model: MCP, the tools and the demo mode still work.
# OPENAI_BASE_URL still works as a deprecated alias for OPENAI_ENDPOINT.
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini. Only the key is needed; endpoint and model have defaults.
GEMINI_API_KEY=

# --- Bedrock (only when AI_PROVIDER=bedrock) --------------------------------
# Credentials come from the standard AWS credential chain (env vars, shared
# config, instance role, SSO) — never put a key in this file.
# Model ids: https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# --- MCP --------------------------------------------------------------------
# Protocol version advertised by the MCP server. Keep in sync with the
# @modelcontextprotocol/sdk version in apps/server/package.json.
MCP_PROTOCOL_VERSION=2025-11-25

# Public base URL of the MCP endpoint, used by the built-in MCP client and
# shown in the UI. Default: http://localhost:${PORT}/api/v1/mcp
MCP_PUBLIC_URL=

# --- Runtime state ----------------------------------------------------------
# Where the run history is written. Empty → apps/server/.muca/runs.
# A relative path resolves from the repository root.
RUN_HISTORY_DIR=
