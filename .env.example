# ---------------------------------------------------------------------------
# Muca — Amazon Developer Hackathon 2026 (Alexa+ track)
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Single port serving BOTH the Next.js frontend (/) and the API + MCP server
# (/api/v1/*). Do not change without also updating the frontend proxy target.
PORT=8099

# Comma-separated list of allowed CORS origins for the API.
ALLOWED_ORIGINS=http://localhost:8099

# --- AI provider ------------------------------------------------------------
# Which provider to use: "openai" (default) or "bedrock".
AI_PROVIDER=openai

# OpenAI (and any OpenAI-compatible endpoint). Point at a local gateway for
# offline dev. Leave the key empty to run Muca without an agent: the MCP
# server and the API still work, and the web UI shows a demo mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Amazon Bedrock. Only used when AI_PROVIDER=bedrock.
# Credentials come from the standard AWS credential chain (env vars, shared
# config, instance role, SSO) — never put a key in this file.
# Model ids: https://docs.aws.amazon.com/bedrock/latest/userguide/models-supported.html
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# --- MCP --------------------------------------------------------------------
# Protocol version advertised by the MCP server. Keep in sync with the
# @modelcontextprotocol/sdk version in apps/server/package.json.
MCP_PROTOCOL_VERSION=2025-11-25

# Public base URL of the MCP endpoint, used by the built-in MCP client and
# shown in the UI. Default: http://localhost:${PORT}/api/v1/mcp
MCP_PUBLIC_URL=

# --- Runtime state ----------------------------------------------------------
# Where the run history is written. Empty → apps/server/.muca/runs.
# A relative path resolves from the repository root.
RUN_HISTORY_DIR=
